---
import { SITE } from "@/siteConfig";
---

<header class="hero">
  <img
    src={SITE.profilePicture}
    alt="Randy lifting his sunglasses"
    height="500"
    width="500"
    loading="eager"
    draggable="false"
    class="profile-photo"
  />
  <h1 class="wordmark">RANDY</h1>
  <p class="bio">{SITE.bio}</p>
</header>
