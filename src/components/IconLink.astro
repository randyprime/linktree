---
import { Icon } from "astro-icon/components";

const { icon, label, url } = Astro.props;
---

<li>
  <a
    href={url}
    aria-label={label}
    title={label}
    target="_blank"
    rel="noopener noreferrer"
    class="social-link"
  >
    <Icon
      name={icon}
      class="social-icon"
    />
  </a>
</li>
